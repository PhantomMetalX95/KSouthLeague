# Turso (leave both blank to use a local file database while developing)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Admin sign-in for the /#/admin page
ADMIN_PASSWORD=change-me-to-something-long
# Optional: secret used to sign login tokens (defaults to the admin password)
SESSION_SECRET=

PORT=3000
